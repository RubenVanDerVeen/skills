                </mxCell>
                <mxCell id="n7h" value="handoff keyword only:&#xa;print /execute-plan &lt;plan-path&gt;&#xa;for a FRESH session" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9" parent="1" vertex="1">
