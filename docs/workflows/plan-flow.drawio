                <mxCell id="m1" value="Orchestrator setup:&#xa;read plan + spec (explore subagent recon);&#xa;branch &lt;type&gt;/&lt;plan-slug&gt;;&#xa;commit plan+spec as &#39;docs:&#39;;&#xa;build todo (1 item per task)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9" parent="1" vertex="1">
