                    <mxGeometry x="95" y="150" width="250" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="Write spec to&#xa;docs/artifacts/features/&lt;topic&gt;/&lt;date&gt;-&lt;slug&gt;-design.md" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=10;fontSize=9" parent="1" vertex="1">
